# ─────────────────────────────────────────────────────────────────
# SCCH Travel Portal — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# SQLite (default, file-based):
DATABASE_URL=sqlite:///./travel_expenses.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/travel_portal

# ── Active Directory / LDAP ───────────────────────────────────────
AD_ENABLED=false
AD_SERVER=ldap://ad.example.com
AD_DOMAIN=example.com
AD_BASE_DN=DC=example,DC=com
AD_BIND_USER=svc_travel@example.com
AD_BIND_PASSWORD=changeme

# ── Google Maps ───────────────────────────────────────────────────
# Required for address autocomplete and map links in the frontend.
GOOGLE_MAPS_API_KEY=

# ── VLM Receipt Extraction ────────────────────────────────────────
# Set VLM_ENABLED=true and provide the endpoint to activate auto-detection.
VLM_ENABLED=false
VLM_BASE_URL=https://vlm.internal.example.com/v1
VLM_API_KEY=
VLM_MODEL=default

# ── Projects File ─────────────────────────────────────────────────
# Path to YAML or JSON file defining projects and work packages.
# If the file does not exist, only DB entries are served.
PROJECTS_FILE=./config/projects.yaml
